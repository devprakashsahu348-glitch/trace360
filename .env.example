# These are set in Netlify: Site configuration -> Environment variables. Never commit real values.
DATABASE_URL=            # REQUIRED. Neon connection string: postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
SECRET_KEY=              # REQUIRED. Long random text: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
CONTACT_EMAIL=devprakashsahu348@gmail.com
OWNER_NAME=Dev Prakash Sahu
PUBLIC_BASE_URL=         # optional; leave empty to use the site's own address (set only if QR codes must point to a custom domain)
ALLOW_REGISTRATION=true  # false = invite-only (you create accounts)
SEED_DEMO=true           # synthetic demo batches for public trace pages
DEMO_LOGIN=false         # keep false on a public site
PLATFORM_ADMIN_KEY=      # optional: lets you read pilot requests via GET /api/leads (header X-Admin-Key)
MAX_UPLOAD_MB=4          # Netlify Functions accept requests up to ~6 MB
TOKEN_HOURS=12
